# Copy to deploy/.env and fill the first three. Everything below them is optional —
# the demo runs fully without a single sponsor key.

# Public hostname. No domain? Use sslip.io: it resolves <ip-with-dashes>.sslip.io to
# that IP, and Caddy will get a real Let's Encrypt certificate for it.
#   203.0.113.10  ->  DOMAIN=203-0-113-10.sslip.io
DOMAIN=203-0-113-10.sslip.io
ACME_EMAIL=you@example.com

# Anvil's default test mnemonic is fine here: this chain is a local stand-in for Arc
# and holds nothing real. Never reuse it for anything that does.
AGENT_MASTER_MNEMONIC="test test test test test test test test test test test junk"
# Account 0 of that mnemonic — the platform operator that creates rounds and settles exits.
ARC_PLATFORM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

POSTGRES_PASSWORD=change-me

# ─── Optional: each one upgrades a part of the demo from fixture to live ─────
# Fixture signals instead of The Graph. Set false once the Graph keys below exist.
DEMO_SIGNALS=true
GRAPH_TOKEN_API_JWT=
# Only if token-api.thegraph.com misbehaves: https://token-api.service.pinax.network (same backend)
GRAPH_TOKEN_API_BASE=
GRAPH_GATEWAY_API_KEY=
GRAPH_MESSARI_DEX_SUBGRAPH_ID=

# Claude decision engine. Without it the deterministic rules engine runs.
ANTHROPIC_API_KEY=
DECISION_ENGINE=auto

# Hedera: HCS audit anchors and agent accounts.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_PAYTO_ACCOUNT_ID=
# Charge agents for the report over x402 as well. Off by default — founders gate
# their own data instead, and that path needs no Hedera keys.
X402_GATE_REPORTS=false

# Privy. Leave empty and onboarding runs in demo mode, labelled as such everywhere.
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_JWKS_JSON=
