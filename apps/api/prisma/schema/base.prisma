generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoundStatus {
  OPEN
  FUNDED
  FAILED
  CLOSED
  EXITED
}

enum ExitKind {
  ACQUISITION
  IPO
  TGE
  CONTRACT
}

enum WalletKind {
  LOCAL_KEY
  CIRCLE
}

enum AgentStatus {
  PAUSED
  RUNNING
}

enum DecisionAction {
  INVEST
  PASS
  WATCH
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
}
