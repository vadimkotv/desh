generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoundStatus {
  OPEN
  FUNDED
  FAILED
  CLOSED
  EXITED
}

enum AccountRole {
  FOUNDER
  INVESTOR
}

enum Visibility {
  PUBLIC
  GATED
}

enum AccessStatus {
  PENDING
  GRANTED
  DENIED
}

enum ExitKind {
  ACQUISITION
  IPO
  TGE
  CONTRACT
}

enum WalletKind {
  LOCAL_KEY
  CIRCLE
}

enum AgentStatus {
  PAUSED
  RUNNING
}

enum AgentMode {
  AUTONOMOUS
  ADVISORY
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum DecisionAction {
  INVEST
  PASS
  WATCH
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
}
