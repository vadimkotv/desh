model Startup {
  id              String             @id @default(uuid())
  name            String
  description     String
  sector          String
  website         String?
  founderAddress  String
  treasuryAddress String
  tokenAddress    String?
  tokenNetwork    String             @default("mainnet")
  githubRepo      String?
  links           Json               @default("[]")
  createdAt       DateTime           @default(now())
  rounds          Round[]
  snapshots       DataRoomSnapshot[]
  metrics         FounderMetric[]
  accessRequests  DataAccessRequest[]
}

// Numbers only the founder has. Stored as a time series, because a metric without a
// trajectory tells an investor nothing. GATED rows are released per agent.
model FounderMetric {
  id         String     @id @default(uuid())
  startupId  String
  startup    Startup    @relation(fields: [startupId], references: [id])
  key        String
  label      String
  unit       String     @default("usd")
  visibility Visibility @default(PUBLIC)
  points     Json
  updatedAt  DateTime   @updatedAt

  @@unique([startupId, key])
}

// One agent asking one founder to open the gated part of the data room.
model DataAccessRequest {
  id        String       @id @default(uuid())
  startupId String
  startup   Startup      @relation(fields: [startupId], references: [id])
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id])
  status    AccessStatus @default(PENDING)
  reason    String       @default("")
  decidedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([startupId, agentId])
  @@index([status, createdAt])
}

model Round {
  id             String               @id @default(uuid())
  startupId      String
  startup        Startup              @relation(fields: [startupId], references: [id])
  onchainRoundId Int?
  escrowAddress  String?
  targetUsdc     Decimal              @db.Decimal(18, 6)
  raisedUsdc     Decimal              @default(0) @db.Decimal(18, 6)
  minTicketUsdc  Decimal              @default(10) @db.Decimal(18, 6)
  deadline       DateTime
  status         RoundStatus          @default(OPEN)
  milestones     Json
  equityBps      Int                  @default(800)
  releasedUsdc   Decimal              @default(0) @db.Decimal(18, 6)
  proceedsUsdc   Decimal              @default(0) @db.Decimal(18, 6)
  createdAt      DateTime             @default(now())
  reports        DueDiligenceReport[]
  decisions      Decision[]
  investments    Investment[]
  exits          ExitEvent[]
}

model ExitEvent {
  id            String   @id @default(uuid())
  roundId       String
  round         Round    @relation(fields: [roundId], references: [id])
  kind          ExitKind
  valuationUsdc Decimal  @default(0) @db.Decimal(24, 6)
  proceedsUsdc  Decimal  @db.Decimal(18, 6)
  evidenceUri   String   @default("")
  txHash        String?
  createdAt     DateTime @default(now())

  @@index([roundId, createdAt])
}

model DataRoomSnapshot {
  id        String   @id @default(uuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  source    String
  signals   Json
  error     String?
  fetchedAt DateTime @default(now())

  @@index([startupId, source, fetchedAt])
}

model DueDiligenceReport {
  id           String     @id @default(uuid())
  roundId      String
  round        Round      @relation(fields: [roundId], references: [id])
  score        Float
  dataCoverage Float
  summary      String
  findings     Json
  signals      Json
  createdAt    DateTime   @default(now())
  decisions    Decision[]

  @@index([roundId, createdAt])
}
