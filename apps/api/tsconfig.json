{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "paths": {
      "@api/*": ["src/*"],
      "@x402/core/server": ["node_modules/@x402/core/dist/cjs/server/index.d.ts"],
      "@x402/core/client": ["node_modules/@x402/core/dist/cjs/client/index.d.ts"],
      "@x402/core/types": ["node_modules/@x402/core/dist/cjs/types/index.d.ts"],
      "@x402/core/http": ["node_modules/@x402/core/dist/cjs/http/index.d.ts"],
      "@x402/hedera/exact/server": ["node_modules/@x402/hedera/dist/cjs/exact/server/index.d.ts"],
      "@x402/hedera/exact/client": ["node_modules/@x402/hedera/dist/cjs/exact/client/index.d.ts"],
      "@x402/express": ["node_modules/@x402/express/dist/cjs/index.d.ts"],
      "@x402/fetch": ["node_modules/@x402/fetch/dist/cjs/index.d.ts"]
    }
  },
  "include": ["src", "prisma", "scripts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
