# ─── Core ───────────────────────────────────────────────────────────────────
PORT=4000
API_PUBLIC_URL=http://localhost:4000            # agents buy data from this URL over x402
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://agentipo:agentipo@localhost:5432/agentipo
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Privy (onboarding) ─────────────────────────────────────────────────────
# Leave both empty and onboarding runs in demo mode: the same screens, a local
# session, and every surface labelled "demo" so a screenshot cannot mislead.
# https://dashboard.privy.io → app → App ID
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: paste the app's JWKS to verify tokens offline instead of fetching
# https://auth.privy.io/api/v1/apps/<appId>/jwks.json on every sign-in.
PRIVY_JWKS_JSON=

# ─── The Graph ──────────────────────────────────────────────────────────────
# Token API JWT: https://thegraph.market  →  API tokens
GRAPH_TOKEN_API_JWT=
# Optional host override (default https://token-api.thegraph.com; same service as https://token-api.service.pinax.network)
GRAPH_TOKEN_API_BASE=
# Gateway API key: https://thegraph.com/studio  →  API keys
GRAPH_GATEWAY_API_KEY=
# Any Messari-standardized DEX subgraph id (search "messari" in https://thegraph.com/explorer)
GRAPH_MESSARI_DEX_SUBGRAPH_ID=
# Agent0 / ERC-8004 subgraph (default: Ethereum Sepolia deployment)
GRAPH_AGENT0_SUBGRAPH_ID=6wQRC7geo9XYAhckfmfo8kbMRLeWU8KQd3XsJqFKmZLT

# ─── Arc (Circle) ───────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
# Deployed packages/contracts RoundEscrow address (see packages/contracts/README.md)
ARC_ESCROW_ADDRESS=
# Platform operator key: creates rounds + releases milestones (fund with USDC from https://faucet.circle.com)
ARC_PLATFORM_PRIVATE_KEY=
# Optional: Circle developer-controlled wallets for CIRCLE-kind agents (Circle Agent Stack)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# ─── Hedera + x402 ──────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# Operator from https://portal.hedera.com (ECDSA key, 0x-hex)
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Account that receives x402 payments for the premium report (usually the operator)
HEDERA_PAYTO_ACCOUNT_ID=
# Existing HCS topic; leave empty to auto-create on first audit write
HEDERA_HCS_TOPIC_ID=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_ASSET=USDC                                 # USDC | HBAR
X402_PREMIUM_REPORT_PRICE=$0.01                 # used when X402_ASSET=USDC
X402_HBAR_TINYBARS=10000000                     # used when X402_ASSET=HBAR (0.1 HBAR)

# ─── Agents ─────────────────────────────────────────────────────────────────
# BIP-39 mnemonic; agent i uses m/44'/60'/0'/0/i for BOTH its Arc wallet and Hedera key
AGENT_MASTER_MNEMONIC=
AGENT_HEDERA_INITIAL_HBAR=5
AGENT_HEDERA_INITIAL_USDC=0.5
# ERC-8004 identity registry (Sepolia by default; Base Sepolia = 84532 + https://sepolia.base.org)
ERC8004_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ERC8004_CHAIN_ID=11155111
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# Decision engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DECISION_ENGINE=auto                            # auto | llm | rules
